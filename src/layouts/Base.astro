---
import { ARBOL } from '../lib/catalogo.js';
import { TASA_IVA } from '../lib/iva.js';
const { titulo, descripcion = 'Talavera 100% mexicana, a la puerta de tu casa.' } = Astro.props;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo ? `${titulo} · Bodega de Talavera` : 'Bodega de Talavera'}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo || 'Bodega de Talavera'} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap" />
  </head>
  <body>
    <header class="barra">
      <a href="/" class="marca" aria-label="Bodega de Talavera">
        <img class="logo-h" src="/logo.svg" alt="Bodega de Talavera" width="531" height="204" />
        <img class="logo-i" src="/icono.svg" alt="Bodega de Talavera" width="204" height="204" />
      </a>
      <nav>
        {ARBOL.map((c) => <a href={`/${c.slug}/`}>{c.nombre}</a>)}
      </nav>
      <a class="wa" href="/carrito/">Carrito <span id="cuenta" hidden>0</span></a>
    </header>

    <script is:inline define:vars={{ TASA_IVA }}>
      // Los precios publicados YA INCLUYEN IVA: se desglosa hacia atras, nunca se
      // suma encima. Vive aqui para que carrito, checkout y seguimiento usen la
      // misma cuenta. La copia del servidor esta en src/lib/iva.js y la prueba
      // test_iva.mjs verifica que subtotal + iva == el precio publicado.
      window.desglosarIva = (conIva) => {
        const t = Math.round(Number(conIva || 0) * 100) / 100;
        const subtotal = Math.round((t / (1 + TASA_IVA)) * 100) / 100;
        return { subtotal, iva: Math.round((t - subtotal) * 100) / 100 };
      };

      // ponytail: carrito en localStorage. No hay backend todavia (la forma de
      // cobro sigue sin decidirse), asi que el pedido se cierra por WhatsApp.
      window.carrito = {
        leer() { try { return JSON.parse(localStorage.getItem('bt_carrito') || '[]'); } catch { return []; } },
        guardar(c) { localStorage.setItem('bt_carrito', JSON.stringify(c)); this.pintar(); },
        agregar(item) {
          const c = this.leer();
          const y = c.find((x) => x.codigo === item.codigo);
          if (y) y.cant += item.cant; else c.push(item);
          this.guardar(c);
        },
        quitar(codigo) { this.guardar(this.leer().filter((x) => x.codigo !== codigo)); },
        cantidad(codigo, n) {
          const c = this.leer();
          const y = c.find((x) => x.codigo === codigo);
          if (y) y.cant = Math.max(1, n);
          this.guardar(c);
        },
        vaciar() { this.guardar([]); },
        piezas() { return this.leer().reduce((s, x) => s + x.cant, 0); },
        total() { return this.leer().reduce((s, x) => s + x.cant * x.precio, 0); },
        pintar() {
          const b = document.getElementById('cuenta');
          if (!b) return;
          const n = this.piezas();
          b.textContent = n;
          b.hidden = n === 0;
        },
      };
      document.addEventListener('DOMContentLoaded', () => window.carrito.pintar());
    </script>

    <main><slot /></main>



    <footer>
      <div class="pie">
        <div>
          <img class="pie-logo" src="/logo.svg" alt="Bodega de Talavera" width="531" height="204" />
          <p>Talavera 100% mexicana, a la puerta de tu casa.</p>
        </div>
        <div>
          <p class="pie-t">Categorías</p>
          {ARBOL.map((c) => <a href={`/${c.slug}/`}>{c.nombre}</a>)}
        </div>
        <div>
          <p class="pie-t">Contacto</p>
          <a href="https://wa.me/525554147383" target="_blank" rel="noopener">WhatsApp +52 55 5414 7383</a>
          <a href="mailto:info@bodegadetalavera.com">info@bodegadetalavera.com</a>
        </div>
        <div>
          <p class="pie-t">Información</p>
          <a href="/terminos/">Términos y condiciones</a>
          <a href="/devoluciones/">Devoluciones y cambios</a>
          <a href="/privacidad/">Aviso de privacidad</a>
        </div>
      </div>
      <p class="legal">Producto artesanal: variaciones de color y medida de hasta 5%. Considera una merma de hasta 5% por traslados y cortes.</p>
    </footer>

    <style is:global>
      :root {
        --indigo: #383188;
        --coral: #f77759;
        --carbon: #2e3641;
        --marfil: #fdfaf3;
        --linea: #e7e2d8;
        --tenue: #6f6a63;
        --radio: 4px;
      }
      * { box-sizing: border-box; }
      /* display en las clases gana sobre el atributo hidden si no se fuerza */
      [hidden] { display: none !important; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--marfil);
        color: var(--carbon);
        font-family: "Nunito Sans", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      h1, h2, h3 { line-height: 1.15; margin: 0; letter-spacing: -0.02em; font-weight: 700; }

      .barra {
        position: sticky; top: 0; z-index: 20;
        display: flex; align-items: center; gap: 28px;
        padding: 12px 28px;
        background: rgba(253, 250, 243, 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--linea);
      }
      /* Regla de la guia: por debajo de 32 px de alto va solo el icono. */
      .marca { display: block; flex: 0 0 auto; }
      .marca img { height: 68px; width: auto; }
      .logo-i { display: none; }
      @media (max-width: 420px) {
        .logo-h { display: none; }
        .logo-i { display: block; height: 38px; }
      }
      .barra nav { display: flex; gap: 22px; margin-left: auto; font-size: 14px; font-weight: 500; }
      .barra nav a:hover { color: var(--indigo); }
      .wa {
        font-size: 13px; font-weight: 600; padding: 7px 14px;
        border: 1px solid var(--linea); border-radius: 999px;
      }
      .wa:hover { border-color: var(--indigo); color: var(--indigo); }
      .wa #cuenta {
        display: inline-block; margin-left: 6px; min-width: 18px; padding: 0 5px;
        background: var(--coral); color: #fff; border-radius: 999px;
        font-size: 11px; line-height: 18px; text-align: center;
      }
      @media (max-width: 820px) {
        .barra { flex-wrap: wrap; gap: 12px; padding: 12px 16px; }
        .barra nav { order: 3; width: 100%; margin: 0; overflow-x: auto; padding-bottom: 2px; }
        .wa { margin-left: auto; }
      }

      main { min-height: 60vh; }
      .contenedor { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
      @media (max-width: 640px) { .contenedor { padding: 0 16px; } }

      .miga { font-size: 13px; color: var(--tenue); padding: 26px 0 0; }
      .miga a:hover { color: var(--indigo); }

      footer { border-top: 1px solid var(--linea); margin-top: 90px; padding: 48px 0 32px; }
      .pie {
        max-width: 1180px; margin: 0 auto; padding: 0 28px;
        display: grid; grid-template-columns: 2fr 1fr 1.4fr 1.2fr; gap: 34px;
        font-size: 14px;
      }
      .pie a { display: block; color: var(--tenue); padding: 2px 0; }
      .pie a:hover { color: var(--indigo); }
      .pie p { margin: 0 0 6px; color: var(--tenue); }
      .pie-logo { height: 52px; width: auto; margin-bottom: 12px; }
      .pie-t { font-weight: 600; color: var(--carbon) !important; margin-bottom: 10px !important; }
      .legal {
        max-width: 1180px; margin: 34px auto 0; padding: 20px 28px 0;
        border-top: 1px solid var(--linea);
        font-size: 12px; color: var(--tenue);
      }
      @media (max-width: 820px) { .pie { grid-template-columns: 1fr 1fr; } }
    </style>
  </body>
</html>
