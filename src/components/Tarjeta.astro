---
import { pesos, COLORES } from '../lib/catalogo.js';
const { p } = Astro.props;
const uni = p.formatos[0].unidad === 'M2' ? 'm²' : 'pieza';
---
<a class="tarjeta" href={`/p/${p.url}/`}>
  <div class="foto">
    <img src={p.foto} alt={p.nombre} loading="lazy" width="600" height="600" />
    {p.foto_generica && p.colores.length > 0 && (
      <span class="gota-color" title={`La foto muestra la pieza; el color es ${p.colores.join(' / ')}`}>
        {p.colores.map((c) => <i style={`background:${COLORES[c] || '#ccc'}`}></i>)}
      </span>
    )}
  </div>
  <div class="txt">
    <p class="nom">{p.nombre}</p>
    <p class="pre">{pesos(p.desde)} <span>/ {uni}</span></p>
  </div>
</a>
<style>
  .tarjeta { display: block; }
  .foto { position: relative; }
  .foto {
    aspect-ratio: 1; overflow: hidden; border-radius: var(--radio);
    background: #fff; border: 1px solid var(--linea);
  }
  .foto img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .tarjeta:hover .foto img { transform: scale(1.04); }
  .txt { padding: 10px 2px 0; }
  .nom { margin: 0; font-size: 14px; font-weight: 500; line-height: 1.3; }
  .pre { margin: 3px 0 0; font-size: 13px; color: var(--tenue); }
  .pre span { font-size: 12px; }
  .gota-color {
    position: absolute; right: 8px; bottom: 8px; display: flex; gap: 3px;
    padding: 4px; background: rgba(255,255,255,.92); border-radius: 999px;
    box-shadow: 0 1px 4px rgba(0,0,0,.12);
  }
  .gota-color i { width: 14px; height: 14px; border-radius: 50%; border: 1px solid rgba(0,0,0,.12); }
</style>
