---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
---
<Base titulo={frontmatter?.titulo}>
  <div class="hoja"><slot /></div>
  <style is:global>
    .hoja { max-width: 760px; margin: 0 auto; padding: 40px 28px 20px; }
    .hoja h1 { font-size: clamp(28px, 4vw, 40px); font-weight: 700; margin-bottom: 8px; }
    .hoja h2 { font-size: 20px; font-weight: 600; margin: 40px 0 12px; }
    .hoja p, .hoja li { font-size: 15px; line-height: 1.7; }
    .hoja table { width: 100%; border-collapse: collapse; margin: 18px 0; font-size: 14px; }
    .hoja th, .hoja td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--linea); }
    .hoja th { background: #fff; font-weight: 600; }
    .hoja hr { border: 0; border-top: 1px solid var(--linea); margin: 34px 0; }
    .hoja code { background: #fff; border: 1px solid var(--linea); padding: 1px 5px; border-radius: 3px; font-size: 13px; }
    .hoja blockquote { border-left: 2px solid var(--coral); margin: 0; padding-left: 16px; color: var(--tenue); }
  </style>
</Base>
