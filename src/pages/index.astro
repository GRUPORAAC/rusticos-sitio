---
import Base from '../layouts/Base.astro';
import Flor from '../components/Flor.astro';
import { GRUPOS_DEF, porGrupo, porCat, piezas, CONTACTO, waHref, telHref, portadas } from '../lib/catalogo.js';
import SECUENCIAS from '../data/secuencias.json';

// Alek 2026-09-10: las secuencias ligadas al scroll NO se activan hasta tener
// el material fotografico real. El motor (public/secuencia.js) y los textos
// (src/data/secuencias.json) quedan listos; solo hay que poner esto en true.
const SECUENCIAS_ACTIVAS = false;

// Una foto por grupo, completa (sin recortes) para las tarjetas del catalogo.
const escoge = (cat, pref = []) => {
  const items = porCat(cat);
  return items.find((p) => pref.some((s) => p.nombre.toLowerCase().includes(s))) || items[0];
};
const PORTADA = {
  'talavera': portadas('talavera-decorada', 1)[0],
  // Alek 2026-09-10: la portada de Baño es la foto BAÑO.jpg de HERO RA (instalacion real)
  'bano': { foto: '/fotos/hero-ra/bano.webp', nombre: 'Baño con talavera' },
  'pisos': portadas('barro', 1)[0],
  'piedra-y-cantera': portadas('piedra', 1)[0],
  'techos': portadas('teja', 1)[0],
};
const grupos = GRUPOS_DEF.map((g) => ({
  ...g,
  cats: porGrupo(g.nombre),
  n: porGrupo(g.nombre).reduce((s, c) => s + porCat(c.slug).length, 0),
  foto: PORTADA[g.slug]?.foto,
}));
// Foto principal: talavera y barro INSTALADOS (FOTOS PRODUCTOS/HERO RA -> public/fotos/hero-ra).
// Foto principal fija: instalacion real (FOTOS PRODUCTOS/HERO RA -> public/fotos/hero-ra).
const HERO = { foto: '/fotos/hero-ra/hero.webp', nombre: 'Cocina con talavera azul y blanco' };
// Album "Así se ve instalado" (Alek 2026-09-10): un cuadro fijo donde las
// fotos de instalacion pasan de pagina. Se muestran COMPLETAS (sin recorte)
// dentro de un marco 4:5. Fuera image17 e image20: traen marca de agua ajena.
const ALBUM = [
  { foto: 'image9', pie: 'Pasillo de barro con cenefa de talavera' },
  { foto: 'image11', pie: 'Escalera con peraltes de talavera' },
  { foto: 'image14', pie: 'Fachada con marco de talavera en la puerta' },
  { foto: 'image24', pie: 'Escalera exterior con peraltes decorados' },
  { foto: 'image7', pie: 'Regadera en arco con talavera azul' },
  { foto: 'image6', pie: 'Mesa de comedor con cenefa de talavera' },
  { foto: 'image25', pie: 'Cocina con talavera azul y blanco' },
  { foto: 'image5', pie: 'Cocina con talavera azul y amarillo' },
  { foto: 'image13', pie: 'Arco con marco de talavera amarillo' },
  { foto: 'image19', pie: 'Puerta con marco de talavera' },
  { foto: 'image21', pie: 'Entrada con marco de talavera' },
  { foto: 'image15', pie: 'Escalinata de barro y talavera' },
];
const NOS = escoge('talavera-decorada', ['collage azul']);

---
<Base claseBody="home">
  <!-- ================================================================ HERO -->
  <section class="hero">
    <div class="contenedor hero-grid">
      <div class="hero-txt">
        <p class="ceja">{CONTACTO.descriptor}</p>
        <h1>Talavera, barro, piedra y cantera <em>a la medida de tu proyecto</em>.</h1>
        <p class="hero-p">Cuéntanos tu idea y te ayudamos a desarrollarla. Escríbenos por WhatsApp o mándanos tus medidas y te asesoramos.</p>
        <div class="hero-cta">
          <a class="boton" href="/catalogo/">Ver el catálogo</a>
          <a class="boton hueco" href="/contacto/">Visítanos</a>
        </div>
        <p class="hero-dato"><Flor tam={12} /> {CONTACTO.direccionCorta}</p>
      </div>
      <figure class="hero-foto">
        <img src={HERO.foto} alt={HERO.nombre} width="774" height="1400" fetchpriority="high" />
        <figcaption>{HERO.nombre}</figcaption>
      </figure>
    </div>
  </section>

  <!-- =========================================================== PILARES -->
  <section class="pilares">
    <div class="contenedor tres">
      <div><b>Talleres con criterio de calidad</b><span>Trabajamos con talleres de Dolores Hidalgo y Puebla: tradición con control de calidad en cada pieza.</span></div>
      <div><b>Tienda física en Coyoacán</b><span>Ve el material en persona y llévate justo lo que necesitas. Sin sorpresas de color ni de textura.</span></div>
      <div><b>Del baño a la fachada</b><span>Talavera, barro, piedra, cantera y teja. Para una remodelación o para un proyecto completo.</span></div>
    </div>
  </section>

  <!-- ========================================================== CATALOGO -->
  <section class="cats" id="catalogo">
    <div class="contenedor">
      <div class="cab-sec">
        <p class="ceja">Catálogo</p>
        <h2>¿Qué estás buscando?</h2>
        <p class="sub">{piezas.length.toLocaleString('es-MX')} piezas con foto, organizadas de lo general a lo particular. Sin precios en línea: cada proyecto se cotiza en tienda, por WhatsApp o por correo.</p>
      </div>
      <div class="grupos">
        {grupos.map((g) => (
          <a class:list={['grupo', !g.n && 'pronto']} href={`/catalogo/${g.slug}/`}>
            <div class="marco">
              {g.foto
                ? <img src={g.foto} alt="" loading="lazy" width="600" height="600" />
                : <div class="marco-vacio"><img src="/icono.svg" alt="" width="120" height="80" /><span>Fotos en camino</span></div>}
            </div>
            <div class="grupo-txt">
              <h3>{g.nombre}</h3>
              <p>{g.lema}</p>
              <ul>{g.cats.map((c) => <li>{c.nombre}</li>)}</ul>
              <span>{g.n ? `${g.n} piezas` : 'Lo tenemos en tienda'} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {SECUENCIAS_ACTIVAS && (
    <>
      <div class="sec-intro contenedor">
        <p class="ceja centro der">Cómo se hace</p>
        <h2>De barro a pieza terminada.</h2>
        <p class="sub">Baja despacio: cada paso avanza con tu scroll.</p>
      </div>
      {SECUENCIAS.map((s, k) => (
        <section class="sec" data-secuencia={`/secuencias/${s.id}/`} data-cuadros={s.cuadros} style="--largo: 3">
          <div class="sec-pegado">
            <canvas aria-hidden="true"></canvas>
            <div class="sec-velo"></div>
            <div class="sec-txt">
              <p class="sec-num">{String(k + 1).padStart(2, '0')}</p>
              <h2 class="sec-t">{s.titulo}</h2>
              <div class="sec-capas">
                {s.textos.map((t) => <p class="sec-capa" data-desde={t.desde} data-hasta={t.hasta}>{t.t}</p>)}
              </div>
              <p class="sec-barra" aria-hidden="true"><i></i></p>
            </div>
          </div>
        </section>
      ))}
      <script>
        import { montarSecuencias } from '../scripts/secuencia.js';
        if (document.querySelector('[data-secuencia]')) montarSecuencias();
      </script>
    </>
  )}

  <!-- =========================================================== EN OBRA -->
  <!-- Libro abierto (Alek 2026-09-10): dos fotos juntas, la de la derecha
       pasa de pagina sobre el lomo y cae sobre la izquierda. Fotos completas. -->
  <section class="obra">
    <div class="contenedor">
      <div class="obra-cab">
        <div>
          <p class="ceja">Aplicado en obra</p>
          <h2>Así se ve instalado.</h2>
        </div>
        <div class="obra-ctl">
          <p class="obra-num"><b id="libro-num">1</b> / {Math.ceil(ALBUM.length / 2)}</p>
          <button class="boton hueco chico" type="button" id="libro-atras" aria-label="Página anterior">← Anterior</button>
          <button class="boton chico" type="button" id="libro-sig" aria-label="Página siguiente">Siguiente →</button>
        </div>
      </div>
      <div class="libro-envoltura">
        <div class="libro" id="libro" aria-label="Fotos de instalación">
          <div class="pag pag-izq"><img src={`/fotos/hero-ra/${ALBUM[0].foto}.webp`} alt={ALBUM[0].pie} width="774" height="1400" /></div>
          <div class="pag pag-der"><img src={`/fotos/hero-ra/${ALBUM[3].foto}.webp`} alt="" width="774" height="1400" /></div>
          <!-- las hojas flexibles se arman en JS: tiras encadenadas (ver script) -->
          <div class="libro-hoja hoja-der" id="hoja-der"></div>
          <div class="libro-hoja hoja-izq" id="hoja-izq" hidden></div>
          <div class="lomo" aria-hidden="true"></div>
        </div>
        <p class="libro-pies"><span id="pie-izq">{ALBUM[0].pie}</span><span id="pie-der">{ALBUM[1].pie}</span></p>
        <div hidden>
          {ALBUM.slice(4).map((a) => <img src={`/fotos/hero-ra/${a.foto}.webp`} alt="" loading="lazy" width="774" height="1400" />)}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================== NOSOTROS -->
  <section class="nosotros" id="nosotros">
    <div class="contenedor nos-grid">
      <div class="nos-txt">
        <p class="ceja">Nosotros</p>
        <h2>Una tienda donde el material se ve en persona.</h2>
        <p>Rústicos Artesanales nació para acercar la talavera y los acabados mexicanos a quienes construyen o remodelan, sin intermediarios y sin complicaciones. Trabajamos directo con talleres de Dolores Hidalgo, Guanajuato y de Puebla.</p>
        <p>Somos una tienda familiar: la misma gente que atiende el mostrador conoce cada color, cada acabado y cada pieza. Si necesitas una medida especial, una combinación que no has visto o simplemente no sabes por dónde empezar, aquí te acompañamos.</p>
        <ul class="nos-lista">
          <li>Talavera lisa, decorada, en relieve y en formas especiales.</li>
          <li>Cintillas y terminaciones en el mismo color que el azulejo.</li>
          <li>Lavabos, muebles de baño y WC decorados.</li>
          <li>Barro, mosaico de pasta, piedra, cantera y teja.</li>
        </ul>
        <a class="boton" href="/contacto/">Cómo llegar</a>
      </div>
      <figure class="nos-foto">
        <img src={NOS.foto} alt={NOS.nombre} loading="lazy" width="700" height="700" />
        <figcaption>{NOS.nombre}</figcaption>
      </figure>
    </div>
  </section>

  <!-- =========================================================== CONTACTO -->
  <section class="visita">
    <div class="contenedor">
      <div class="visita-cab">
        <p class="ceja">Te esperamos</p>
        <h2>Pasa a la tienda o escríbenos.</h2>
      </div>
      <div class="visita-grid">
        <div class="visita-mapa">
          <iframe title="Ubicación de Rústicos Artesanales" src={CONTACTO.mapaEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="visita-dir">
          <p class="ceja">Dirección</p>
          <p class="visita-calle">{CONTACTO.direccion}</p>
          <div class="visita-mapas">
            <a class="boton hueco" href={CONTACTO.mapsGoogle} target="_blank" rel="noopener">Google Maps</a>
            <a class="boton hueco" href={CONTACTO.mapsApple} target="_blank" rel="noopener">Apple Maps</a>
          </div>
        </div>
      </div>
      <div class="visita-contacto">
        <p class="sub">Mándanos tus medidas y te asesoramos.</p>
        <div class="visita-botones">
          <a class="boton" href={waHref('Hola, vi su catálogo en la página y quiero cotizar.')} target="_blank" rel="noopener">WhatsApp {CONTACTO.whatsappBonito}</a>
          <a class="boton hueco" href={telHref(CONTACTO.telefonos[0])}>Llamar {CONTACTO.telefonos[0]}</a>
          <a class="boton hueco" href={`mailto:${CONTACTO.correo}`}>{CONTACTO.correo}</a>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ ALBUM }}>
    // Libro abierto con HOJA FLEXIBLE (Alek 2026-09-10: "que simule una hoja
    // real, flexible, calmada, dinamica").
    //
    // Cada hoja son N tiras verticales ENCADENADAS: la tira 0 cuelga del lomo
    // y cada tira siguiente cuelga del borde de la anterior. La tira del lomo
    // hace el giro completo (0 -> 180°); las demas solo se doblan unos grados
    // respecto a la anterior, con mas doblez a medio vuelo y ninguno al caer.
    // Como estan anidadas, la curva es continua: no hay huecos entre tiras.
    // Cada tira muestra su columna de la foto por las dos caras.
    const libro = document.getElementById('libro');
    if (libro) {
      const N = 14;                      // tiras por hoja
      const M = ALBUM.length;
      const src = (i) => `/fotos/hero-ra/${ALBUM[((i % M) + M) % M].foto}.webp`;
      const pieDe = (i) => ALBUM[((i % M) + M) % M].pie;
      const izq = libro.querySelector('.pag-izq img');
      const der = libro.querySelector('.pag-der img');
      const pieI = document.getElementById('pie-izq'), pieD = document.getElementById('pie-der');
      const num = document.getElementById('libro-num');
      const lento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Construye la cadena de tiras dentro de una hoja. `lado` = 'der' | 'izq'.
      // Devuelve { raiz, frentes[], dorsos[] } donde frentes[c] / dorsos[c] es
      // la imagen de la COLUMNA c (0 = borde izquierdo de la pagina).
      function armar(hoja, lado) {
        hoja.innerHTML = '';
        const frentes = new Array(N), dorsos = new Array(N);
        let padre = hoja, raiz = null;
        for (let d = 0; d < N; d++) {
          // columna que ocupa esta tira en su pagina: la raiz esta junto al lomo
          const col = lado === 'der' ? d : N - 1 - d;
          // al caer del otro lado, la tira ocupa la columna espejo
          const colDorso = N - 1 - col;
          const tira = document.createElement('div');
          tira.className = 'tira' + (d === 0 ? ' raiz' : ' doblez');
          // el doblez crece hacia la orilla libre: la hoja se curva mas en la punta
          // suma ~32° en la punta a medio vuelo: se curva sin pasar por debajo del libro
          tira.style.setProperty('--doblez', (1.2 + d * 0.18) + 'deg');
          const cara = (clase, c) => {
            const el = document.createElement('div');
            el.className = 'cara ' + clase;
            const img = document.createElement('img');
            img.alt = ''; img.width = 774; img.height = 1400; img.draggable = false;
            // la cara mide 1px de mas (sin costuras); se compensa aqui para que
            // las columnas de todas las tiras empalmen exactamente
            img.style.width = `calc(${N * 100}% - ${N}px)`;
            img.style.left = `calc(${-c * 100}% + ${c}px)`;
            el.appendChild(img);
            return { el, img };
          };
          const f = cara('frente', col), b = cara('dorso', colDorso);
          frentes[col] = f.img; dorsos[colDorso] = b.img;
          tira.appendChild(f.el); tira.appendChild(b.el);
          padre.appendChild(tira);
          if (d === 0) raiz = tira;
          padre = tira;
        }
        return { raiz, frentes, dorsos };
      }
      const hd = document.getElementById('hoja-der'), hi = document.getElementById('hoja-izq');
      const HD = armar(hd, 'der'), HI = armar(hi, 'izq');
      const poner = (imgs, url) => imgs.forEach((im) => { im.src = url; });

      let k = 0, girando = false, visible = true, timer = null;

      function pintar() {
        // reposo: izquierda k, derecha k+1; la hoja derecha ya trae k+1 al frente y k+2 al dorso
        izq.src = src(k); izq.alt = pieDe(k);
        poner(HD.frentes, src(k + 1)); poner(HD.dorsos, src(k + 2));
        der.src = src(k + 3);
        pieI.textContent = pieDe(k); pieD.textContent = pieDe(k + 1);
        num.textContent = Math.floor(k / 2) + 1;
      }

      function pasar(dir) {
        if (girando) return;
        girando = true;
        let H, hoja;
        if (dir > 0) {
          H = HD; hoja = hd;
        } else {
          H = HI; hoja = hi; hi.hidden = false;
          poner(HI.frentes, src(k)); poner(HI.dorsos, src(k - 1));
          izq.src = src(k - 2);
          der.src = src(k + 1); hd.hidden = true;
        }
        libro.classList.add('girando');
        hoja.classList.add('gira');
        let listo = false;
        const terminar = () => {
          if (listo) return;
          listo = true;
          k = (k + 2 * dir + M) % M;
          hoja.classList.remove('gira');
          libro.classList.remove('girando');
          hi.hidden = true; hd.hidden = false;
          pintar();
          setTimeout(() => { girando = false; }, 60);
        };
        H.raiz.addEventListener('animationend', terminar, { once: true });
        setTimeout(terminar, 2300);
      }

      function programar() {
        clearInterval(timer);
        if (!lento && visible && !document.hidden) timer = setInterval(() => pasar(1), 5200);
      }
      new IntersectionObserver((es) => { visible = es[0].isIntersecting; programar(); }, { threshold: 0.3 }).observe(libro);
      document.addEventListener('visibilitychange', programar);
      document.getElementById('libro-sig').addEventListener('click', () => { pasar(1); programar(); });
      document.getElementById('libro-atras').addEventListener('click', () => { pasar(-1); programar(); });
      // Clic: mitad izquierda atras, mitad derecha adelante (escritorio).
      // Si el clic viene justo despues de un deslizamiento, se ignora.
      let deslizo = false;
      libro.addEventListener('click', (e) => {
        if (deslizo) { deslizo = false; return; }
        pasar(e.clientX < libro.getBoundingClientRect().left + libro.clientWidth / 2 ? -1 : 1);
        programar();
      });
      // Gesto en celular/tablet (Alek 2026-09-11): deslizar a la izquierda pasa
      // la pagina, a la derecha regresa. Solo cuenta si el movimiento es mas
      // horizontal que vertical, para no estorbar el scroll de la pagina.
      let x0 = null, y0 = null;
      libro.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
      libro.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
        x0 = y0 = null;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          deslizo = true;
          pasar(dx < 0 ? 1 : -1);
          programar();
          setTimeout(() => { deslizo = false; }, 400);
        }
      }, { passive: true });
      pintar();
    }
  </script>

  <style is:global>
    /* ================= hoja flexible del libro (elementos creados en JS) ================= */
    /* --n: tiras por hoja. Cada tira mide 1/n de la pagina y cuelga de la anterior. */
    .libro { --n: 14; --dur: 2.1s; }
    .libro-hoja { position: absolute; top: 0; bottom: 0; width: 50%; z-index: 2; transform-style: preserve-3d; pointer-events: none; }
    .hoja-der { left: 50%; }
    .hoja-izq { left: 0; }
    .tira {
      position: absolute; top: 0; bottom: 0; width: calc(100% / var(--n));
      transform-style: preserve-3d; will-change: transform;
    }
    /* raiz: pegada al lomo. Las demas cuelgan del borde de su padre. */
    .hoja-der .tira.raiz { left: 0; transform-origin: left center; }
    .hoja-der .tira.doblez { left: 100%; width: 100%; transform-origin: left center; }
    .hoja-izq .tira.raiz { right: 0; transform-origin: right center; }
    .hoja-izq .tira.doblez { right: 100%; width: 100%; transform-origin: right center; }
    .tira .cara {
      /* right: -1px — la cara se mete 1px debajo de la tira siguiente: sin costuras */
      position: absolute; inset: 0; right: -1px; overflow: hidden;
      backface-visibility: hidden; -webkit-backface-visibility: hidden;
      background: var(--arena-claro);
    }
    .tira .dorso { transform: rotateY(180deg); }
    /* max-width: none — el reset global pone img { max-width: 100% } y aplastaba la columna a 1/n */
    .tira .cara img { position: absolute; top: 0; height: 100%; max-width: none; object-fit: contain; display: block; }
    /* borde superior/inferior de la pagina */
    .tira .cara::before { content: ''; position: absolute; inset: 0; border-top: 1px solid var(--linea); border-bottom: 1px solid var(--linea); pointer-events: none; }
    /* sombra que se mueve con el vuelo: se oscurece al levantarse, se aclara al caer */
    .tira .cara::after { content: ''; position: absolute; inset: 0; background: rgba(60,42,36,.28); opacity: 0; pointer-events: none; }

    /* ---- giro: la raiz da la vuelta completa, calmada; los dobleces se curvan y se aplanan ---- */
    .libro-hoja.gira .tira.raiz { animation: libro-raiz var(--dur) cubic-bezier(.42, 0, .22, 1) both; }
    .libro-hoja.gira .tira.doblez { animation: libro-doblez var(--dur) ease-in-out both; }
    .libro-hoja.gira .tira .cara::after { animation: libro-sombra var(--dur) ease-in-out both; }
    .hoja-der.gira .tira.raiz { --giro: -180deg; --signo: 1; }
    .hoja-izq.gira .tira.raiz { --giro: 180deg; --signo: -1; }
    .hoja-der.gira .tira.doblez { --signo: 1; }
    .hoja-izq.gira .tira.doblez { --signo: -1; }
    @keyframes libro-raiz {
      from { transform: rotateY(0deg); }
      to   { transform: rotateY(var(--giro)); }
    }
    /* la orilla se retrasa al levantarse (doblez maximo temprano) y se aplana al caer */
    @keyframes libro-doblez {
      0%   { transform: rotateY(0deg); }
      30%  { transform: rotateY(calc(var(--doblez) * var(--signo) * 1)); }
      60%  { transform: rotateY(calc(var(--doblez) * var(--signo) * .55)); }
      85%  { transform: rotateY(calc(var(--doblez) * var(--signo) * -.12)); }
      100% { transform: rotateY(0deg); }
    }
    @keyframes libro-sombra {
      0% { opacity: 0; } 45% { opacity: .55; } 100% { opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .libro-hoja.gira .tira.raiz, .libro-hoja.gira .tira.doblez, .libro-hoja.gira .tira .cara::after { animation-duration: .01s; }
    }
  </style>

  <style>
    /* ------------------------------------------------------------- hero */
    .hero { padding: 64px 0 40px; }
