---
import Base from '../layouts/Base.astro';
import { ARBOL, porCat, productos } from '../lib/catalogo.js';

// Miniatura rotativa: hasta 6 fotos por categoria. La PRIMERA es la estrella
// (la que se congela al pasar el puntero en escritorio).
const ESTRELLA = ['Blanco Mexicano', 'Azul Intermedio', 'Amarillo Liso', 'Verde Especial'];
const cats = ARBOL.map((c) => {
  const items = porCat(c.slug);
  const estrella = items.find((p) => ESTRELLA.includes(p.color)) || items[0];
  const resto = items.filter((p) => p !== estrella);
  const fotos = [estrella, ...resto.filter((_, i) => i % Math.max(1, Math.floor(resto.length / 5)) === 0)]
    .slice(0, 6)
    .filter(Boolean)
    .map((p) => p.foto);
  return { ...c, fotos, n: items.length };
});
const total = productos.length;

// ---------------------------------------------------------------- HERO Y OBRA
// Fotos propias de RAAC (carpeta HERO BT). `url` = ficha a la que lleva la foto.
// Las cintillas todavia NO se venden en linea (no estan en el ARBOL), asi que van
// sin liga. ponytail: cuando exista la cintilla Verde Especial, ponle aqui su slug.
const HERO = {
  foto: 'cintilla-rojo-brillante-en-espiga',
  pie: 'Cintilla rojo brillante, colocada en espiga',
  url: null,
};
const OBRA = [
  { foto: 'arlequin-verde-y-cintillas-blanco-y-verde', pie: 'Arlequín verde con cintillas blanco y verde', url: 'decorado-arlequin-verde' },
  { foto: 'espanolita-jade', pie: 'Españolita jade', url: 'mate-espanolito-jade' },
  { foto: 'escamas-azul-deslavado', pie: 'Escamas azul deslavado', url: 'deslavado-escama-azul-cobalto' },
  { foto: 'azulejo-vino', pie: 'Azulejo vino', url: 'liso-vino' },
  { foto: 'azulejo-verde-deslavado', pie: 'Azulejo verde deslavado', url: 'deslavado-verde' },
  { foto: 'azulejo-azul', pie: 'Azulejo azul', url: 'especial-azul' },
  { foto: 'cintilla-verde-especial-en-espiga', pie: 'Cintilla verde especial en espiga', url: null },
  { foto: 'cintilla-azul-deslavado-ladrillo', pie: 'Cintilla azul deslavado en ladrillo', url: null },
  { foto: 'cintilla-naranja', pie: 'Cintilla naranja', url: null },
].filter((o) => !o.url || productos.some((x) => x.url === o.url));
---
<Base>
  <section class="hero">
    <img class="hero-foto" src={`/fotos/hero/${HERO.foto}.webp`} alt={HERO.pie} width="1200" height="1800" />
    <div class="contenedor hero-txt">
      <h1>Talavera 100% mexicana,<br />a la puerta de tu casa.</h1>
      <p class="reta">¿Quién te dijo que la talavera era anticuada?</p>
      {HERO.url
        ? <a class="cta" href={`/p/${HERO.url}/`}>Ver este producto</a>
        : <a class="cta" href="#categorias">Ver el catálogo</a>}
      <p class="hero-pie">{HERO.pie}</p>
    </div>
  </section>


  <section class="contenedor cats" id="categorias">
    <div class="cuadricula">
      {cats.map((c) => (
        <a class="cat" href={`/${c.slug}/`} data-rota>
          <div class="marco">
            {c.fotos.map((f, i) => (
              <img src={f} alt="" class={i === 0 ? 'on' : ''} loading={i === 0 ? 'eager' : 'lazy'} width="600" height="600" />
            ))}
          </div>
          <div class="cat-txt">
            <h2>{c.nombre}</h2>
            <p>{c.lema}</p>
            <span>{c.n} {c.n === 1 ? 'producto' : 'productos'}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="escaparate">
    <div class="contenedor">
      <h2>Así se ve instalado</h2>
      <p class="sub">Trabajos hechos con material de Bodega de Talavera.</p>
    </div>
    <div class="tira" id="tira">
      <div class="pista" id="pista">
        {OBRA.map((o, i) => (
          <figure>
            <img src={`/fotos/hero/${o.foto}.webp`} alt={o.pie} loading={i < 3 ? 'eager' : 'lazy'} />
            {o.url
              ? <a class="ver-prod" href={`/p/${o.url}/`}>Ver producto</a>
              : <span class="ver-prod pronto">Próximamente</span>}
            <figcaption>{o.pie}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="franja">
    <div class="contenedor tres">
      <div><b>{total} productos</b><span>Con foto y precio, listos para pedir.</span></div>
      <div><b>Entrega en CDMX y zona conurbada</b><span>El resto del país se cotiza por WhatsApp.</span></div>
      <div><b>Hecho a mano, pieza por pieza</b><span>Variaciones de hasta 5%: así se ve lo artesanal.</span></div>
    </div>
  </section>


  <script>
    // Hilera del escaparate: sin barra, con "rebote" al topar en cualquiera de
    // los dos extremos. ponytail: 12 lineas, sin libreria de carrusel.
    const tira = document.getElementById('tira');
    const pista = document.getElementById('pista');
    if (tira && pista) {
      let previo = 0, ocupado = false;
      const golpe = (signo) => {
        if (ocupado) return;
        ocupado = true;
        pista.style.transform = `translateX(${signo * 16}px)`;
        setTimeout(() => { pista.style.transform = ''; ocupado = false; }, 220);
      };
      tira.addEventListener('scroll', () => {
        const tope = tira.scrollWidth - tira.clientWidth;
        const dir = tira.scrollLeft - previo;
        previo = tira.scrollLeft;
        if (dir > 0 && tira.scrollLeft >= tope - 1) golpe(-1);
        else if (dir < 0 && tira.scrollLeft <= 1) golpe(1);
      }, { passive: true });
    }
  </script>
  <script>
    // Escritorio: rota ~1.5s y se CONGELA en la estrella al pasar el puntero.
    // Movil (sin puntero fino): rota sola a 3.5s y un tap entra a la categoria.
    const fino = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const lento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('[data-rota]').forEach((card) => {
      const fotos = [...card.querySelectorAll('img')];
      if (fotos.length < 2 || lento) return;
      let i = 0, quieto = false;
      setInterval(() => {
        if (quieto) return;
        fotos[i].classList.remove('on');
        i = (i + 1) % fotos.length;
        fotos[i].classList.add('on');
      }, fino ? 1500 : 3500);
      if (fino) {
        card.addEventListener('mouseenter', () => {
          quieto = true;
          fotos[i].classList.remove('on');
          i = 0;
          fotos[0].classList.add('on');
        });
        card.addEventListener('mouseleave', () => { quieto = false; });
      }
    });
  </script>

  <style>
    .cats { padding: 76px 0 8px; }
    .hero { position: relative; isolation: isolate; overflow: hidden; }
    .hero-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
    .hero::after {
      content: ''; position: absolute; inset: 0; z-index: -1;
      background: linear-gradient(180deg, rgba(0,0,0,.55), rgba(0,0,0,.35) 45%, rgba(0,0,0,.6));
    }
    .hero-txt { position: relative; color: #fff; padding: 150px 16px 132px; }
    .hero-txt h1, .hero-txt .reta { color: #fff; }
    .hero-pie { margin: 18px 0 0; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; opacity: .8; }
    @media (max-width: 640px) { .hero-txt { padding: 96px 16px 84px; } }

    /* ---------------- escaparate en hilera ---------------- */
    .escaparate { padding: 96px 0 64px; --alto-obra: clamp(300px, 46vh, 440px); }
    .escaparate h2 { font-size: clamp(24px, 3vw, 34px); margin: 0 0 6px; }
    .escaparate .sub { margin: 0 0 38px; color: var(--tenue); }
    .tira {
      display: flex; overflow-x: auto; scroll-snap-type: x proximity;
      padding: 6px 0 10px; scrollbar-width: none; -ms-overflow-style: none;
      overscroll-behavior-x: contain;
    }
    .tira::-webkit-scrollbar { display: none; }
    .pista {
      display: flex; gap: 34px; padding: 0 max(16px, calc((100vw - 1200px) / 2));
      transition: transform .18s cubic-bezier(.2,.8,.3,1); will-change: transform;
    }
    .pista figure {
      position: relative; margin: 0; scroll-snap-align: start;
      flex: 0 0 calc(var(--alto-obra) * 4 / 5);
    }
    /* Alek 2026-09-03: TODAS DEL MISMO TAMANO, grandes, y que quepan en la
       pantalla. Por eso el tamano se define por ALTURA (46vh, atada al
       viewport) y la proporcion 4:5 saca el ancho: uniforme siempre, y nunca
       mas alto de lo que da la pantalla. */
    .pista img {
      width: 100%; height: var(--alto-obra); object-fit: cover; display: block;
      border-radius: var(--radio); background: #ece8e1;
      transition: filter .35s ease, transform .35s ease;
    }
    .pista figcaption { font-size: 12px; color: var(--tenue); padding: 14px 2px 0; }
    .ver-prod {
      position: absolute; left: 50%; top: calc(50% - 18px);
      transform: translate(-50%, -50%) scale(.96);
      padding: 9px 18px; border-radius: 999px; background: #fff; color: var(--carbon);
      font-weight: 600; font-size: 13px; white-space: nowrap;
      opacity: 0; pointer-events: none; z-index: 3;
      transition: opacity .3s ease, transform .3s ease;
    }
    .ver-prod.pronto { background: rgba(255,255,255,.9); color: var(--tenue); cursor: default; }
    .pista figure:hover img { filter: blur(6px) brightness(.85); transform: scale(1.02); }
    .pista figure:hover .ver-prod { opacity: 1; pointer-events: auto; transform: translate(-50%, -50%) scale(1); }
    @media (hover: none) { .pista figure .ver-prod { opacity: 1; pointer-events: auto; } .pista figure img { filter: brightness(.9); } }

    .hero { padding: 92px 0 78px; }
    .hero h1 { font-size: clamp(34px, 5.6vw, 64px); font-weight: 700; letter-spacing: -0.035em; }
    .reta {
      margin: 22px 0 0; font-size: clamp(16px, 2vw, 21px);
      color: var(--coral); font-weight: 600;
    }
    .cta {
      display: inline-block; margin-top: 32px; padding: 13px 26px;
      background: var(--indigo); color: #fff; border-radius: 999px;
      font-size: 14px; font-weight: 600;
    }
    .cta:hover { background: var(--coral); }

    .cuadricula { display: grid; grid-template-columns: repeat(3, 1fr); gap: 52px 40px; }
    @media (max-width: 900px) { .cuadricula { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .cuadricula { grid-template-columns: 1fr; gap: 36px; } }

    .marco {
      position: relative; aspect-ratio: 4 / 3; overflow: hidden;
      border-radius: var(--radio); background: #fff; border: 1px solid var(--linea);
    }
    .marco img {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; opacity: 0; transition: opacity .6s ease;
    }
    .marco img.on { opacity: 1; }
    .cat-txt { padding: 20px 2px 0; }
    .cat-txt h2 { font-size: 20px; font-weight: 600; }
    .cat-txt p { margin: 5px 0 0; font-size: 14px; color: var(--tenue); }
    .cat-txt span { display: block; margin-top: 6px; font-size: 12px; color: var(--indigo); font-weight: 600; }

    .franja { margin-top: 110px; padding: 60px 0; border-top: 1px solid var(--linea); }
    .tres { display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px; }
    .tres b { display: block; font-size: 15px; }
    .tres span { display: block; margin-top: 5px; font-size: 14px; color: var(--tenue); }
    @media (max-width: 760px) { .tres { grid-template-columns: 1fr; gap: 22px; } }
  </style>
  <style>
  </style>
</Base>
