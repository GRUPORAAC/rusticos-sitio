---
// Ornamento de la marca: la flor de cuatro petalos del logotipo, en terracota.
// Se usa como separador y como vineta; nunca como icono funcional.
const { tam = 18, clase = '' } = Astro.props;
---
<svg class:list={['flor', clase]} width={tam} height={tam} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path fill="currentColor" d="M12 1.5c1.6 2.4 2.6 4.4 2.6 6.2S13.4 11 12 11s-2.6-1.5-2.6-3.3S10.4 3.9 12 1.5zm0 21c-1.6-2.4-2.6-4.4-2.6-6.2S10.6 13 12 13s2.6 1.5 2.6 3.3-1 3.8-2.6 6.2zM1.5 12c2.4-1.6 4.4-2.6 6.2-2.6S11 10.6 11 12s-1.5 2.6-3.3 2.6S3.9 13.6 1.5 12zm21 0c-2.4 1.6-4.4 2.6-6.2 2.6S13 13.4 13 12s1.5-2.6 3.3-2.6 3.8 1 6.2 2.6z"/>
</svg>
<style>
  .flor { display: inline-block; color: var(--terracota); vertical-align: middle; flex: 0 0 auto; }
</style>
