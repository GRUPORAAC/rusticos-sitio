---
import Base from '../layouts/Base.astro';
import { productos, plazo, uni } from '../lib/catalogo.js';

// ponytail: el pegazulejo se sugiere aqui, que es donde se decide la compra.
// Sin motor de recomendaciones: son 2 productos, se listan tal cual.
const pega = productos.filter((p) => p.cat === 'pegazulejo');
---
<Base titulo="Tu pedido">
  <div class="contenedor hoja-carrito">
    <h1>Tu pedido</h1>

    <p id="vacio" class="vacio" hidden>
      Todavía no has agregado nada. <a href="/">Ver el catálogo →</a>
    </p>

    <div id="lleno" hidden>
      <table class="lista">
        <thead>
          <tr><th>Producto</th><th>Formato</th><th class="num">Cantidad</th><th class="num">Precio</th><th class="num">Importe</th><th></th></tr>
        </thead>
        <tbody id="filas"></tbody>
      </table>

      {pega.length > 0 && (
        <section class="complemento">
          <h2>Complementos</h2>
          <div class="pega">
            {pega.map((p) => (
              <article class="pz">
                <img src={p.foto} alt={p.nombre} width="120" height="120" loading="lazy" />
                <div>
                  <h3>{p.nombre}</h3>
                  <p class="precio">{'$' + p.formatos[0].precio_venta.toLocaleString('es-MX')} <span>por {uni(p.formatos[0].unidad)}</span></p>
                  <button type="button" class="add-pega" data-cod={p.formatos[0].codigo} data-nom={p.nombre}
                    data-fmt={p.formatos[0].formato || ''} data-uni={uni(p.formatos[0].unidad)}
                    data-pre={p.formatos[0].precio_venta} data-plazo={plazo(p).txt}>Agregar</button>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <div class="cierre">
        <div class="notas">
          <p><b>El envío no está incluido.</b> Se calcula al confirmar el pedido: CDMX y los 16 municipios conurbados van con tarifa; el resto del país se cotiza.</p>
          <p><b>Producto artesanal:</b> variaciones de color y medida de hasta 5%. Considera además hasta 5% de merma por traslados y cortes — pide entre 5% y 10% de material extra.</p>
          <p id="plazo-aviso"></p>
        </div>
        <div class="totales">
          <div class="fila"><span>Productos</span><b id="total">$0</b></div>
          <div class="fila chico"><span>Envío</span><span>Se calcula al confirmar</span></div>
          <a href="/pagar/" class="enviar">Continuar al pago</a>
          <button id="vaciar" class="vaciar">Vaciar carrito</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const pesos = (n) => '$' + Number(n).toLocaleString('es-MX', { maximumFractionDigits: 0 });

    function pintar() {
      const c = window.carrito.leer();
      document.getElementById('vacio').hidden = c.length > 0;
      document.getElementById('lleno').hidden = c.length === 0;
      if (!c.length) return;

      document.getElementById('filas').innerHTML = c
        .map(
          (x) => `<tr>
            <td class="prod">
              <img src="${x.foto}" alt="" width="52" height="52" />
              <div><a href="/p/${x.url}/">${x.nombre}</a><small>${x.codigo}</small></div>
            </td>
            <td>${x.formato}</td>
            <td class="num"><input type="number" min="${x.min || 1}" step="${x.paso || 1}" value="${x.cant}" data-cod="${x.codigo}" /> <small>${x.unidad}</small></td>
            <td class="num">${pesos(x.precio)}</td>
            <td class="num">${pesos(x.precio * x.cant)}</td>
            <td class="num"><button class="x" data-cod="${x.codigo}" aria-label="Quitar">×</button></td>
          </tr>`
        )
        .join('');

      document.getElementById('total').textContent = pesos(window.carrito.total());

      // El plazo del pedido lo marca el articulo mas lento.
      const lento = c.some((x) => (x.plazo || '').startsWith('15')) ;
      const desconocido = c.some((x) => (x.plazo || '').includes('según'));
      document.getElementById('plazo-aviso').innerHTML = lento
        ? '<b>Entrega:</b> tu pedido incluye piezas con plazo extendido, así que se entrega completo en 15 a 25 días hábiles. Si prefieres recibir antes lo que está en existencia, dínoslo y lo separamos en dos entregas.'
        : desconocido
        ? '<b>Entrega:</b> confirmamos la fecha exacta al procesar tu pedido — entre 5 y 25 días hábiles según disponibilidad.'
        : '<b>Entrega:</b> 5 a 7 días hábiles, todo en existencia.';

      document.querySelectorAll('#filas input').forEach((i) =>
        i.addEventListener('change', () => { window.carrito.cantidad(i.dataset.cod, +i.value); pintar(); })
      );
      document.querySelectorAll('.add-pega').forEach((b) =>
        b.addEventListener('click', () => {
          const d = b.dataset;
          window.carrito.agregar({ codigo: d.cod, nombre: d.nom, formato: d.fmt, unidad: d.uni,
                                   precio: +d.pre, cant: 1, plazo: d.plazo });
          pintar();
        })
      );
      document.querySelectorAll('.x').forEach((b) =>
        b.addEventListener('click', () => { window.carrito.quitar(b.dataset.cod); pintar(); })
      );
    }

    document.getElementById('vaciar').onclick = () => { window.carrito.vaciar(); pintar(); };
    pintar();
  </script>

  <style>
    .complemento { margin: 34px 0 10px; padding-top: 26px; border-top: 1px solid var(--linea); }
    .complemento h2 { font-size: 18px; font-weight: 700; margin-bottom: 14px; }
    .pega { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .pz { display: flex; gap: 14px; align-items: center; border: 1px solid var(--linea); border-radius: 12px; padding: 12px; }
    .pz img { width: 84px; height: 84px; object-fit: cover; border-radius: 8px; flex: none; }
    .pz h3 { font-size: 14px; font-weight: 600; line-height: 1.3; }
    .pz .precio { font-size: 14px; font-weight: 700; margin: 4px 0 8px; }
    .pz .precio span { font-weight: 400; font-size: 12px; color: var(--tenue); }
    .add-pega { padding: 7px 14px; border: 1px solid var(--indigo); border-radius: 999px; background: #fff;
                color: var(--indigo); font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
    .add-pega:hover { background: var(--indigo); color: #fff; }
    .hoja-carrito { padding-top: 34px; }
    .hoja-carrito h1 { font-size: clamp(28px, 4vw, 40px); margin-bottom: 26px; }
    .vacio { color: var(--tenue); }
    .vacio a { color: var(--indigo); font-weight: 600; }

    .lista { width: 100%; border-collapse: collapse; font-size: 14px; }
    .lista th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--tenue); font-weight: 600; padding: 0 10px 10px; }
    .lista td { padding: 14px 10px; border-top: 1px solid var(--linea); vertical-align: middle; }
    .num { text-align: right; }
    th.num { text-align: right; }
    .prod { display: flex; gap: 12px; align-items: center; }
    .prod img { border-radius: var(--radio); border: 1px solid var(--linea); }
    .prod a { display: block; font-weight: 600; }
    .prod small { display: block; color: var(--tenue); font-size: 11px; }
    .lista input { width: 58px; padding: 6px; border: 1px solid var(--linea); border-radius: var(--radio); font: inherit; text-align: center; }
    .x { border: 0; background: none; font-size: 20px; color: var(--tenue); cursor: pointer; line-height: 1; }
    .x:hover { color: var(--coral); }

    .cierre { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; margin-top: 40px; }
    @media (max-width: 820px) { .cierre { grid-template-columns: 1fr; gap: 26px; } }
    .notas p { font-size: 13px; color: var(--tenue); margin: 0 0 12px; }
    .notas b { color: var(--carbon); }

    .totales { border: 1px solid var(--linea); border-radius: var(--radio); background: #fff; padding: 20px; height: fit-content; }
    .fila { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 12px; }
    .fila b { font-size: 22px; }
    .fila.chico { font-size: 13px; color: var(--tenue); border-top: 1px solid var(--linea); padding-top: 12px; }
    .enviar { display: block; text-align: center; padding: 14px; margin-top: 8px; background: var(--indigo); color: #fff; border-radius: 999px; font-weight: 600; }
    .enviar:hover { background: var(--coral); }
    .vaciar { display: block; width: 100%; margin-top: 10px; padding: 8px; border: 0; background: none; color: var(--tenue); font: inherit; font-size: 13px; cursor: pointer; }
    .vaciar:hover { color: var(--coral); }
  </style>
</Base>
