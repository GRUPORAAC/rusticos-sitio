---
import Base from '../../layouts/Base.astro';
import Rejilla from '../../components/Rejilla.astro';
import { ARBOL, porSub } from '../../lib/catalogo.js';
import Colores from '../../components/Colores.astro';
import FAMS from '../../data/familias.json';


export function getStaticPaths() {
  const rutas = [];
  for (const c of ARBOL) {
    for (const s of c.subs) {
      const items = porSub(c.slug, s.slug);
      if (items.length) rutas.push({ params: { cat: c.slug, sub: s.slug }, props: { c, s, items } });
    }
  }
  return rutas;
}
const { c, s, items } = Astro.props;

// Filtro por color: circulitos. Dentro de una subcategoria de azulejo el filtro
// por acabado sobra, ya entraste por acabado (decision 2026-08-27).
---
<Base titulo={`${s.nombre} · ${c.nombre}`}>
  <div class="contenedor">
    <p class="miga"><a href="/">Inicio</a> · <a href={`/${c.slug}/`}>{c.nombre}</a> · {s.nombre}</p>
    <header class="cab">
      <h1>{s.nombre}</h1>
      <p><b>{items.length}</b> {items.length === 1 ? 'producto' : 'productos'} en {c.nombre.toLowerCase()}.</p>
    </header>

    <Colores items={items} />

    <div id="lista">
      <Rejilla items={items} />
    </div>
    <p class="vacio vacio-filtro" hidden>No hay productos de ese color en esta sección.</p>
  </div>

  <script define:vars={{ mapa: Object.fromEntries(items.map((p) => [p.url, p.colores])), fams: FAMS }}>
    import('/filtro.js').then((m) => m.montarFiltro(mapa, fams));
  </script>

  <style>
    .cab { padding: 18px 0 24px; }
    .cab h1 { font-size: clamp(28px, 4vw, 42px); font-weight: 700; }
    .cab p { margin: 8px 0 0; color: var(--tenue); }
    .cab b { color: var(--carbon); font-weight: 600; }
    .vacio { color: var(--tenue); padding: 30px 0; }
  </style>
</Base>
