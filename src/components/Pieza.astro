---
// Una pieza de la galeria: foto + nombre. Sin precio, sin codigo, sin pagina
// propia (brief 2026-09-10). El clic la amplia en el visor de Base.astro.
const { p, sub = '', entera = false, prioridad = false } = Astro.props;
import { rutaDe } from '../lib/catalogo.js';
const fotos = [p.foto, ...(p.galeria || [])].join('|');
---
<div class:list={['pieza', entera && 'entera']} data-id={p.id} data-nombre={p.nombre} data-sub={sub} data-fotos={fotos} data-ruta={rutaDe(p)} tabindex="0" role="button" aria-label={`Ampliar ${p.nombre}`}>
  <div class="pieza-foto">
    <img src={p.foto} alt={p.nombre} loading={prioridad ? 'eager' : 'lazy'} decoding="async" width="600" height="600" />
  </div>
  <p class="pieza-nom">{p.nombre}</p>
</div>
<style>
  .pieza { cursor: zoom-in; outline: none; }
  /* La foto se muestra COMPLETA, nunca recortada (Alek 2026-09-10). */
  .pieza-foto {
    aspect-ratio: 1; overflow: hidden; border-radius: var(--radio); padding: 8px;
    background: var(--blanco); border: 1px solid var(--linea);
    display: flex; align-items: center; justify-content: center;
    transition: border-color .2s ease;
  }
  .pieza-foto img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .pieza:hover .pieza-foto, .pieza:focus-visible .pieza-foto { border-color: var(--terracota); }
  .pieza-nom { margin: 10px 2px 0; font-size: 13px; font-weight: 500; line-height: 1.3; color: var(--cacao); }
</style>
