---
import Base from '../../layouts/Base.astro';
import { GRUPOS_DEF, porGrupo, porCat, piezas, portadas } from '../../lib/catalogo.js';

// Nivel 1 del catalogo: los GRUPOS. De lo general a lo particular (Alek
// 2026-09-10): grupo -> categoria -> galeria. Cada grupo muestra una foto
// completa por categoria, sin recortes.
const grupos = GRUPOS_DEF.map((g) => {
  const cats = porGrupo(g.nombre).map((c) => {
    const items = porCat(c.slug);
    return { ...c, n: items.length, foto: portadas(c.slug, 1)[0]?.foto };
  });
  return { ...g, cats, n: cats.reduce((s, c) => s + c.n, 0) };
});
---
<Base titulo="Catálogo" descripcion="Talavera, baño, pisos, piedra y cantera, techos. Todo lo que tenemos en tienda, con foto y sin precios en línea.">
  <div class="contenedor">
    <p class="miga"><a href="/">Inicio</a> <span>·</span> Catálogo</p>
    <header class="cab">
      <p class="ceja">Catálogo</p>
      <h1>¿Qué estás buscando?</h1>
      <p class="intro">Variedad de materiales, acabados y modelos para cualquier espacio.</p>
    </header>

    {grupos.map((g) => (
      <section class="grupo">
        <div class="grupo-cab">
          <div>
            <h2><a href={`/catalogo/${g.slug}/`}>{g.nombre}</a></h2>
            <p>{g.lema}</p>
          </div>
          <a class="boton hueco" href={`/catalogo/${g.slug}/`}>{g.n ? `Ver ${g.nombre.toLowerCase()} · ${g.n} piezas` : 'Ver más'}</a>
        </div>
        <div class="cats">
          {g.cats.map((c) => (
            <a class:list={['cat', !c.n && 'pronto']} href={`/${c.slug}/`}>
              <div class="marco">
                {c.foto
                  ? <img src={c.foto} alt="" loading="lazy" width="600" height="600" />
                  : <div class="marco-vacio"><img src="/icono.svg" alt="" width="120" height="80" /><span>Fotos en camino</span></div>}
              </div>
              <div class="cat-txt">
                <h3>{c.nombre}</h3>
                <span>{c.n ? `${c.n} ${c.n === 1 ? 'pieza' : 'piezas'}` : 'En tienda'}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <style>
    .miga { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--tenue); padding: 26px 0 0; }
    .miga span { margin: 0 6px; color: var(--arena); }
    .cab { padding: 26px 0 10px; max-width: 760px; }
    .cab h1 { margin-top: 14px; }
    .intro { margin-top: 14px; color: var(--tenue); }
    .grupo { margin-top: 60px; padding-top: 28px; border-top: 1px solid var(--linea); }
    .grupo-cab { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .grupo-cab h2 a:hover { color: var(--terracota); }
    .grupo-cab p { margin-top: 6px; color: var(--tenue); max-width: 560px; }
    .cats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px 22px; margin-top: 28px; }
    @media (max-width: 1000px) { .cats { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 640px) { .cats { grid-template-columns: repeat(2, 1fr); gap: 20px 14px; } }
    .cat { display: block; }
    .marco { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; padding: 12px; background: var(--blanco); border: 1px solid var(--linea); border-radius: var(--radio); transition: border-color .15s ease; }
    .cat:hover .marco { border-color: var(--terracota); }
    .marco img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
    .marco-vacio { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; background: var(--arena-claro); }
    .marco-vacio img { width: 80px; height: auto; opacity: .5; }
    .marco-vacio span { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--tenue); }
    .cat-txt { padding: 12px 2px 0; }
    .cat-txt h3 { font-size: 22px; }
    .cat-txt span { display: block; margin-top: 4px; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--terracota); font-weight: 500; }
    .cat.pronto .cat-txt span { color: var(--tenue); }
  </style>
</Base>
