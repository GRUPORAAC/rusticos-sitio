---
import Tarjeta from './Tarjeta.astro';
const { items } = Astro.props;
---
<div class="rejilla">
  {items.map((p) => <Tarjeta p={p} />)}
</div>
<style>
  .rejilla {
    display: grid; gap: 46px 32px;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
  @media (max-width: 520px) {
    .rejilla { grid-template-columns: repeat(2, 1fr); gap: 30px 18px; }
  }
</style>
