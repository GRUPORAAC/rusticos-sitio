---
import Base from '../layouts/Base.astro';
import Flor from '../components/Flor.astro';
import { CONTACTO, waHref, telHref, portadas } from '../lib/catalogo.js';

// Los datos son los MISMOS del anuncio impreso (raac-app/buenfin.py, PROMOS y
// CONDICIONES de RUSTICOS). Si cambia una promocion, se cambia alla y aqui:
// son dos piezas de la misma campana y no pueden decir cosas distintas.
const VIGENCIA = '13 al 17 de noviembre de 2026';
const GANCHO = 'Ese pendiente de su casa, esta semana cuesta menos.';

const wa = (q) => waHref(`Hola, vi la promoción del Buen Fin en la página. ${q}`);

// Orden de la pagina (Alek 2026-11-10): primero el 3.5% de toda la tienda,
// porque aplica a todo y va junto al encabezado; luego el 35% de las mesas.
const TIENDA = {
  t: 'Toda la tienda', pct: '3.5%', url: '/catalogo/',
  q: 'Quiero cotizar con el descuento del Buen Fin.',
};
const GANADORA = {
  t: 'Mesas de ónix', pct: '35%', antes: '$3,600', ahora: '$2,340',
  nota: 'Pieza única. Sujeta a existencia.',
  foto: '/fotos/BUEN FIN/MESAS DE ONIX.webp',
  q: 'Me interesa la mesa de ónix con 35%.',
};

// CON FOTO: card horizontal, la foto completa a un lado.
const CON_FOTO = [
  { t: 'WC de talavera', pct: '15%', antes: '$8,550', ahora: '$7,265',
    // Los modelos en existencia los dicto Alek el 2026-11-10. La promocion es
    // solo sobre estos: si se agota uno, se quita de esta linea.
    nota: 'Precio del WC decorado. Seis modelos en piso.',
    url: '#existencias-wc',
    cat: 'wc-decorados', q: 'Me interesa un WC de talavera con 15%.' },
  { t: 'Mosaico de pasta', pct: '15%',
    nota: 'Sobre pedido, 15 a 20 días hábiles.', url: '/mosaico-de-pasta/',
    cat: 'mosaico-de-pasta', q: 'Me interesa el mosaico de pasta con 15%.' },
  { t: 'Lámparas de botella', pct: '25%', antes: '$1,100', ahora: '$825',
    nota: 'Botella de vino, con pantalla cilíndrica o semicónica. Sujeto a existencia.',
    f: '/fotos/BUEN FIN/LAMPARAS DE BOTELLA.webp',
    q: 'Me interesan las lámparas de botella con 25%.' },
  { t: 'Talavera poblana', pct: '15%', antes: '$75', ahora: '$63.75',
    nota: 'Precio por pieza. Trece modelos en piso.',
    f: '/fotos/TALAVERA/PUEBLA/1.webp', url: '#existencias-poblana',
    q: 'Me interesa la talavera poblana con 15%.' },
  { t: 'Muebles de baño', pct: '10%',
    nota: 'Incluye ovalín, espejo y mezcladora.', url: '#existencias-muebles',
    cat: 'muebles-de-bano', q: 'Me interesa un mueble de baño con 10%.' },
];

// SIN FOTO: no hay foto de estas tres en la galeria, asi que van juntas en una
// hilera de recuadros chicos; sin foto no se deja hueco (Alek 2026-11-10).
const SIN_FOTO = [
  { t: 'Teja plástica', pct: '15%', nota: 'En existencia.',
    q: 'Me interesa la teja plástica con 15%.' },
];

// Lo que hay en piso esta semana. La promocion es sobre ESTOS modelos: el
// cliente no llega al catalogo completo, llega a lo que puede ver y llevarse
// (Alek 2026-11-10). Lista dictada por Alek; la foto es la del catalogo.
// Los tres candados contra el «lo tenían anunciado y ya no lo tienen»: corte
// con fecha y hora, pieza unica a la vista, y apartado con anticipo. La cuarta
// es el alcance del descuento: la promocion es del WC, no del conjunto.
const CORTE = 'Existencias al martes 10 de noviembre de 2026, 5:00 p.m.';
const APARTADO = 'Para asegurar una pieza, apártala con anticipo: te la guardamos 48 horas.';
const AVISO = `Consulta disponibilidad en tienda o al ${CONTACTO.whatsappBonito}.`;
// Al armar el bloque de muebles de baño: foto del mueble SOLO, sin WC (Alek
// 2026-11-10). El WC y el mueble son dos promociones distintas y la foto no
// puede sugerir que el 10% se los lleva los dos.
const EXISTENCIAS = [
  { id: 'wc', t: 'WC de talavera en existencia', pct: '15%',
    // Cada pieza del conjunto lleva SU descuento, no el del WC (Alek 2026-11-10).
    alcance: 'El 15% es sobre el WC. El mueble de baño lleva su propio 10%, que ya incluye ovalín, espejo y mezcladora; el lavabo por separado lleva el 3.5% de toda la tienda.',
    unica: true,
    piezas: [
      { n: 'Veracruz Blanco',     f: '/fotos/TALAVERA/WC DECORADOS/VERACRUZ BLANCO.webp' },
      { n: 'Bouquet',             f: '/fotos/TALAVERA/WC DECORADOS/BOUQUET.webp' },
      { n: 'Talavereado Colores', f: '/fotos/TALAVERA/WC DECORADOS/TALAVEREADO COLORES.webp' },
      { n: 'Girasol Azul',        f: '/fotos/TALAVERA/WC DECORADOS/GIRASOL AZUL.webp' },
      { n: 'Talavereado Azul II', f: '/fotos/TALAVERA/WC DECORADOS/TALAVEREADO AZUL II.webp' },
      { n: 'Seville',             f: '/fotos/TALAVERA/WC DECORADOS/SEVILLE.webp' },
    ] },
  { id: 'muebles', t: 'Muebles de baño en existencia', pct: '10%',
    alcance: 'El 10% incluye ovalín, espejo y mezcladora.',
    unica: true,
    piezas: [
      { n: 'Romano Bouquet',            f: '/fotos/TALAVERA/PAQUETES DE BANO/MUEBLE ROMANO BOUQUET.webp' },
      { n: 'Madera Talavereado Azul',   f: '/fotos/TALAVERA/PAQUETES DE BANO/MUEBLE MADERA TALAVEREADO AZUL.webp' },
      { n: 'Curvo Seville',             f: '/fotos/TALAVERA/PAQUETES DE BANO/MUEBLE CURVO SEVILLE.webp' },
      { n: 'Mixto Talavereado Colores', f: '/fotos/TALAVERA/PAQUETES DE BANO/MUEBLE MIXTO TALAVEREADO COLORES.webp' },
      { n: 'Madera Girasol Azul',       f: '/fotos/TALAVERA/PAQUETES DE BANO/MUEBLE MADERA GIRASOL AZUL.webp' },
      { n: 'Romano Mini Alcatraz',       f: '/fotos/TALAVERA/PAQUETES DE BANO/MUEBLE ROMANO MINI ALCATRAZ.webp' },
      { n: 'Aguamanil Veracruz Blanco',  f: '/fotos/TALAVERA/PAQUETES DE BANO/MUEBLE AGUAMANIL VERACRUZ BLANCO PURO.webp' },
      { n: 'Mesa de Sobreponer Mármol',  f: '/fotos/TALAVERA/PAQUETES DE BANO/MUEBLE MESA DE SOBREPONER MARMOL.webp' },
    ] },
  { id: 'poblana', t: 'Talavera poblana en existencia', pct: '15%',
    alcance: 'Azulejo de Puebla de 10 × 10 cm, pintado a mano. Se vende por pieza.',
    piezas: [
      { n: 'Poblano 1', f: '/fotos/TALAVERA/PUEBLA/1.webp' },
      { n: 'Poblano 6', f: '/fotos/TALAVERA/PUEBLA/6.webp' },
      { n: 'Poblano 7', f: '/fotos/TALAVERA/PUEBLA/7.webp' },
      { n: 'Poblano 8', f: '/fotos/TALAVERA/PUEBLA/8.webp' },
      { n: 'Poblano 9', f: '/fotos/TALAVERA/PUEBLA/9.webp' },
      { n: 'Poblano 10', f: '/fotos/TALAVERA/PUEBLA/10.webp' },
      { n: 'Poblano 14', f: '/fotos/TALAVERA/PUEBLA/14.webp' },
      { n: 'Poblano 20', f: '/fotos/TALAVERA/PUEBLA/20.webp' },
      { n: 'Poblano 22', f: '/fotos/TALAVERA/PUEBLA/22.webp' },
      { n: 'Poblano 28', f: '/fotos/TALAVERA/PUEBLA/28.webp' },
      { n: 'Poblano 30', f: '/fotos/TALAVERA/PUEBLA/30.webp' },
      { n: 'Poblano 31', f: '/fotos/TALAVERA/PUEBLA/31.webp' },
      { n: 'Poblano 32', f: '/fotos/TALAVERA/PUEBLA/32.webp' },
    ] },
];

const CONDICIONES = [
  `Vigencia del ${VIGENCIA} o hasta agotar existencias.`,
  'Promociones no acumulables entre sí: cada producto lleva el descuento de su categoría.',
  'Muebles, WC y pedidos mayores a $10,000 van a precio de lista con 3 meses sin intereses.',
  'Los meses sin intereses no aplican con BBVA, Banamex ni American Express.',
  'Precios con IVA incluido. El envío se cobra aparte.',
];

const foto = (cat) => portadas(cat, 1)[0]?.foto;
const destino = (p) => p.url || wa(p.q);
const fuera = (p) => (p.url ? null : '_blank');
---
<Base
  titulo={`Buen Fin ${VIGENCIA}`}
  descripcion={`Buen Fin en Rústicos Artesanales: 3.5% en toda la tienda y hasta 35% de descuento del ${VIGENCIA} en talavera, WC, muebles de baño, mosaico de pasta y teja. Tienda física en Coyoacán, CDMX.`}
  claseBody="bf"
>
  <!-- ============================================================ PORTADA -->
  <section class="bf-hero">
    <div class="contenedor bf-hero-in">
      <div class="bf-hero-txt">
        <p class="ceja">{VIGENCIA}</p>
        <h1>Buen&nbsp;Fin</h1>
        <div class="bf-flor"><Flor tam={22} /></div>
        <p class="bf-gancho">{GANCHO}</p>
        <div class="bf-fila">
          <a class="bf-tienda" href={TIENDA.url}>
            <span class="bf-pct grande">{TIENDA.pct}</span>
            <span class="bf-tienda-txt">
              <b>en toda la tienda</b>
              <span class="bf-link">Ver el catálogo →</span>
            </span>
          </a>
          <div class="bf-hero-cta">
            <a class="boton bf-wa" href={wa(TIENDA.q)} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.3L2 22l4.8-1.5c1.5.9 3.3 1.4 5.2 1.4 5.5 0 10-4.5 10-10S17.5 2 12 2zm5.5 12.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.2-.7-1.6-1-2.2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3 4.8 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.3-.3-.6-.4z"/></svg>
              Mándanos un WhatsApp
            </a>
            <a class="boton hueco" href="/contacto/">Visita nuestra tienda</a>
          </div>
        </div>
        <p class="bf-invita">Visita nuestra tienda para conocer existencias.</p>
        <p class="bf-dato"><Flor tam={12} /> {CONTACTO.direccionCorta} · Lun a vie 9–19, sáb 9–16</p>
      </div>
      <img class="bf-cal" src="/buen-fin/calendario.png" alt={`El Buen Fin, ${VIGENCIA}`} width="885" height="877" />
    </div>
  </section>

  <!-- ====================================================== MESAS DE ÓNIX -->
  <section class="bf-gancho-sec" id="promociones">
    <a class="contenedor bf-destacado" href={destino(GANADORA)} target={fuera(GANADORA)} rel="noopener">
      <img src={GANADORA.foto} alt={GANADORA.t} width="1536" height="1024" />
      <div>
        <span class="bf-pct grande">{GANADORA.pct}</span>
        <h2>{GANADORA.t}</h2>
        <p class="bf-precio"><s>antes {GANADORA.antes}</s> <b>ahora {GANADORA.ahora}</b></p>
        <p class="bf-nota">{GANADORA.nota}</p>
        <span class="bf-link">Pregúntanos por WhatsApp →</span>
      </div>
    </a>
  </section>

  <!-- ======================================================== PROMOCIONES -->
  <section class="bf-promos">
    <div class="contenedor">
      <p class="ceja centro der cab-bf">Y además, del 13 al 17</p>

      <div class="bf-lista">
        {CON_FOTO.map((p) => (
          <a class="bf-card" href={destino(p)} target={fuera(p)} rel="noopener">
            <div class="bf-card-foto"><img src={p.f || foto(p.cat)} alt="" loading="lazy" width="700" height="700" /></div>
            <div class="bf-card-txt">
              <span class="bf-pct">{p.pct}</span>
              <h3>{p.t}</h3>
              {p.antes && <p class="bf-precio chico"><s>antes {p.antes}</s> <b>ahora {p.ahora}</b></p>}
              <p class="bf-nota">{p.nota}</p>
              <span class="bf-link">{(p.url || '').startsWith('#') ? 'Ver los que hay en tienda →' : 'Ver en el catálogo →'}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="bf-hilera">
        {SIN_FOTO.map((p) => (
          <a class="bf-card chica" href={destino(p)} target={fuera(p)} rel="noopener">
            <span class="bf-pct">{p.pct}</span>
            <h3>{p.t}</h3>
            {p.antes && <p class="bf-precio chico"><s>antes {p.antes}</s> <b>ahora {p.ahora}</b></p>}
            <p class="bf-nota">{p.nota}</p>
            <span class="bf-link">Pregúntanos por WhatsApp →</span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ======================================================= EN EXISTENCIA -->
  {EXISTENCIAS.map((g) => (
    <section class="bf-exist" id={`existencias-${g.id}`}>
      <div class="contenedor">
        <div class="bf-exist-cab">
          <span class="bf-pct">{g.pct}</span>
          <h2>{g.t}</h2>
          <p class="bf-corte">{CORTE}</p>
          {g.alcance && <p class="bf-alcance">{g.alcance}</p>}
          <p class="bf-aviso">{APARTADO} {AVISO}</p>
        </div>
        <div class="bf-piezas">
          {g.piezas.map((x) => (
            <figure class="bf-pieza">
              <img src={x.f} alt={x.n} loading="lazy" width="700" height="700" />
              <figcaption>{x.n}{g.unica && <span class="bf-unica">Pieza única</span>}</figcaption>
            </figure>
          ))}
        </div>
        <a class="boton bf-wa" href={wa('Quiero ver los WC de talavera que tienen en existencia.')} target="_blank" rel="noopener">Preguntar por WhatsApp</a>
      </div>
    </section>
  ))}

  <!-- ========================================================== WHATSAPP -->
  <section class="bf-cta">
    <div class="contenedor bf-cta-in">
      <p class="ceja centro der">Lo resolvemos por mensaje</p>
      <h2>Mándanos tus medidas y te cotizamos con el descuento.</h2>
      <p class="bf-cta-p">Dinos qué estás buscando y cuántos metros necesitas. Si prefieres verlo en persona, estamos en Coyoacán toda la semana del Buen Fin.</p>
      <a class="boton bf-wa enorme" href={wa(TIENDA.q)} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.3L2 22l4.8-1.5c1.5.9 3.3 1.4 5.2 1.4 5.5 0 10-4.5 10-10S17.5 2 12 2zm5.5 12.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.2-.7-1.6-1-2.2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3 4.8 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.3-.3-.6-.4z"/></svg>
        {CONTACTO.whatsappBonito}
      </a>
      <div class="bf-otros">
        {CONTACTO.telefonos.map((t) => <a href={telHref(t)}>Tel. {t}</a>)}
        <a href={`mailto:${CONTACTO.correo}`}>{CONTACTO.correo}</a>
        <a href={CONTACTO.mapsGoogle} target="_blank" rel="noopener">Cómo llegar →</a>
      </div>
    </div>
  </section>

  <!-- ======================================================= CONDICIONES -->
  <section class="bf-legal">
    <div class="contenedor bf-legal-in">
      <div>
        <p class="bf-legal-t">Condiciones</p>
        <ul>{CONDICIONES.map((c) => <li>{c}</li>)}</ul>
      </div>
      <figure class="bf-sello">
        <img src="/buen-fin/qr-rusticos.png" alt="Código QR de registro de Rústicos Artesanales en El Buen Fin 2026" width="480" height="480" />
        <figcaption>Oferta válida del {VIGENCIA}. Consulta tiendas participantes en <a href="https://www.elbuenfin.org" target="_blank" rel="noopener">www.elbuenfin.org</a></figcaption>
      </figure>
    </div>
  </section>
</Base>

<style>
  /* Buen Fin de Rusticos: la misma paleta e identidad de la casa (cacao,
     terracota, arena, marfil; Cormorant + Montserrat). No es una campana
     aparte, es la tienda en semana de Buen Fin. */
  .bf-hero { background: linear-gradient(180deg, #EFE2CE 0%, var(--marfil) 100%); padding: 56px 0 64px; border-bottom: 1px solid var(--linea); }
  .bf-hero-in { display: grid; grid-template-columns: 1fr 210px; gap: 40px; align-items: start; }
  .bf-cal { width: 100%; height: auto; margin-top: -6px; }
  .bf-hero-txt h1 { font-size: clamp(54px, 9vw, 104px); margin: 10px 0 0; letter-spacing: -0.02em; }
  .bf-flor { margin: 14px 0 16px; }
  .bf-gancho { font-family: var(--serif); font-size: clamp(22px, 2.8vw, 32px); font-style: italic; color: var(--terracota); line-height: 1.2; max-width: 20em; }

  /* el 3.5% de toda la tienda: la promocion que aplica a todo, junto al titulo */
  .bf-tienda {
    display: flex; align-items: center; gap: 22px; margin: 26px 0 4px; padding: 20px 26px;
    background: var(--cacao); color: var(--marfil); border-radius: var(--radio);
    transition: background .2s ease;
  }
  .bf-tienda:hover { background: #2C1E1A; }
  .bf-tienda .bf-pct.grande { font-size: clamp(40px, 6vw, 64px); color: #E08A4E; }
  .bf-tienda-txt { display: flex; flex-direction: column; line-height: 1.35; }
  .bf-tienda-txt b { font-family: var(--serif); font-size: clamp(22px, 2.6vw, 30px); font-weight: 600; }
  .bf-tienda-txt > span { font-size: 12.5px; color: var(--arena); }
  .bf-tienda .bf-link { margin-top: 8px; color: var(--arena); }


  /* el 3.5% y los botones, hombro con hombro */
  .bf-fila { display: flex; flex-wrap: wrap; align-items: stretch; gap: 18px; margin: 26px 0 14px; }
  .bf-invita { font-family: var(--serif); font-size: 19px; color: var(--cacao); margin-bottom: 6px; }
  .bf-hero-cta { display: flex; flex-direction: column; justify-content: center; gap: 12px; }
  .bf-dato { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--tenue); }

  .bf-wa { background: #25D366; border-color: #25D366; color: #fff; font-size: 15px; padding: 18px 30px; }
  .bf-wa:hover { background: #1DA851; border-color: #1DA851; }
  .bf-wa.enorme { font-size: clamp(18px, 2.6vw, 26px); padding: 24px 44px; letter-spacing: .04em; text-transform: none; font-weight: 600; border-radius: 6px; }

  /* mesas de onix */
  .bf-gancho-sec { padding: 56px 0 0; }
  .bf-destacado { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; background: var(--arena-claro); border: 1px solid var(--linea); border-radius: var(--radio); padding: 36px 40px; text-align: center; max-width: var(--ancho); transition: border-color .2s ease; }
  .bf-destacado img { width: 100%; height: auto; border-radius: var(--radio); }
  @media (max-width: 760px) { .bf-destacado { grid-template-columns: 1fr; gap: 20px; } }
  .bf-destacado:hover { border-color: var(--terracota); }
  .bf-destacado h2 { margin: 2px 0 10px; }

  .bf-pct { display: inline-block; font-family: var(--sans); font-weight: 600; color: var(--terracota); letter-spacing: -0.02em; font-size: 32px; line-height: 1; }
  .bf-pct.grande { font-size: clamp(56px, 9vw, 112px); }
  .bf-precio { font-family: var(--serif); font-size: 26px; }
  .bf-precio s { color: var(--tenue); }
  .bf-precio b { font-family: var(--sans); font-weight: 600; font-size: 22px; }
  .bf-precio.chico { font-size: 19px; } .bf-precio.chico b { font-size: 17px; }
  .bf-nota { font-size: 12.5px; color: var(--tenue); margin-top: 8px; }
  .bf-link { display: inline-block; margin-top: 14px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--terracota); }

  /* promociones con foto: card horizontal, la foto entra COMPLETA */
  .bf-promos { padding: 54px 0 10px; }
  .cab-bf { display: flex; justify-content: center; margin: 0 auto 30px; }
  .bf-lista { display: grid; gap: 20px; }
  .bf-card {
    display: grid; grid-template-columns: 300px 1fr; align-items: center;
    background: var(--blanco); border: 1px solid var(--linea); border-radius: var(--radio);
    overflow: hidden; transition: border-color .2s ease;
  }
  .bf-card:hover { border-color: var(--terracota); }
  .bf-card-foto { background: var(--arena-claro); }
